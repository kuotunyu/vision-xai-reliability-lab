# Optional overrides. Copy to .env if needed; .env is gitignored.

# Override where the Oxford-IIIT Pet dataset and manifests are stored
# (defaults to ./data relative to the working directory). Useful on Colab,
# where the dataset belongs on fast local disk rather than a mounted Drive.
# VISION_XAI_DATA_DIR=

# Override where trained checkpoints are read from and written to
# (defaults to ./checkpoints relative to the working directory). The serving
# layer reads the same variable, so the API can be pointed at a checkpoint
# directory mounted read-only — see docker-compose.yml.
# VISION_XAI_CHECKPOINTS_DIR=

# Logging level for the CLI (DEBUG, INFO, WARNING, ERROR).
# VISION_XAI_LOG_LEVEL=INFO
