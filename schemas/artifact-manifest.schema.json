{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vision-xai/artifact-manifest.schema.json",
  "title": "Vision XAI release artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_snapshot", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "source_snapshot": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "hash_mode", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "hash_mode": {"enum": ["binary", "text-lf"]},
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Raw bytes for binary mode; canonical LF bytes for text-lf mode."
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
