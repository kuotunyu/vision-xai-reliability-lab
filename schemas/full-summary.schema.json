{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vision-xai/full-summary.schema.json",
  "title": "Vision XAI full-scale aggregate summary",
  "type": "object",
  "required": [
    "schema_version",
    "experiment",
    "config_hash",
    "generated_at",
    "scale_note",
    "notes",
    "train",
    "localization",
    "faithfulness",
    "randomization",
    "consistency",
    "spurious"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment": {"const": "full"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scale_note": {"type": "string", "minLength": 1},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "train": {"type": "object", "minProperties": 4},
    "localization": {"type": "object", "minProperties": 2},
    "faithfulness": {"type": "object", "minProperties": 2},
    "randomization": {"type": "object", "minProperties": 2},
    "consistency": {"type": "object", "minProperties": 2},
    "spurious": {"type": "object", "minProperties": 2}
  }
}
